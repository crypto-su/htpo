{
  "name": "@8bit.tr/htpo",
  "version": "0.1.0",
  "description": "HTML to PDF Offline — browser-side HTML pagination and PDF generation with explicit diagnostics.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Ugur Yildirim",
    "email": "info@8bit.tr",
    "url": "https://8bit.tr"
  },
  "homepage": "https://htpo.8bit.tr",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crypto-su/htpo.git"
  },
  "bugs": {
    "url": "https://github.com/crypto-su/htpo/issues"
  },
  "keywords": ["html-to-pdf", "pdf", "browser", "offline", "typescript"],
  "unpkg": "./dist/htpo.min.js",
  "jsdelivr": "./dist/htpo.min.js",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "docs",
    "assets/fonts/LICENSE.txt"
  ],
  "main": "./dist/htpo.umd.cjs",
  "module": "./dist/htpo.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/htpo.js",
      "require": "./dist/htpo.umd.cjs"
    },
    "./htpo.min.js": "./dist/htpo.min.js"
  },
  "scripts": {
    "dev": "vite build --watch --config vite.standalone.config.ts",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.build.json && npm run build:standalone",
    "build:standalone": "vite build --config vite.standalone.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "test:standalone": "npm run build && playwright test --config playwright.standalone.config.ts",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
